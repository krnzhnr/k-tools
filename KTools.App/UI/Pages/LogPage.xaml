<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="KTools_App.UI.Pages.LogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:KTools_App.ViewModels"
    xmlns:models="using:KTools_App.Models"
    xmlns:converters="using:KTools_App.Converters"
    x:DataType="viewmodels:LogViewModel"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Регистрация конвертера для раскраски текста логов по уровням -->
        <converters:LogLevelToBrushConverter x:Key="LogLevelToBrushConverter" />
    </Page.Resources>

    <Grid Padding="36,12,36,36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель управления -->
        <StackPanel 
            Grid.Row="0" 
            Orientation="Horizontal" 
            Spacing="8" 
            Margin="0,0,0,16">
            <Button 
                x:Name="CopyAllButton" 
                Command="{x:Bind ViewModel.CopyAllLogsCommand}"
                ToolTipService.ToolTip="Копировать все логи в буфер обмена Windows">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Copy" />
                    <TextBlock Text="Копировать все" />
                </StackPanel>
            </Button>
            <Button 
                x:Name="OpenLogDirButton" 
                Command="{x:Bind ViewModel.OpenLogDirectoryCommand}"
                ToolTipService.ToolTip="Открыть папку с логами в Проводнике Windows">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Folder" />
                    <TextBlock Text="Открыть папку логов" />
                </StackPanel>
            </Button>
            <Button 
                x:Name="ClearLogButton" 
                Command="{x:Bind ViewModel.ClearLogsCommand}"
                ToolTipService.ToolTip="Очистить текущее окно отображения журналов">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Delete" />
                    <TextBlock Text="Очистить" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Высокопроизводительный виртуализированный список вывода логов в реальном времени с поддержкой выделения и копирования -->
        <ListView 
            Grid.Row="1"
            x:Name="LogListView"
            ItemsSource="{x:Bind ViewModel.Logs, Mode=OneWay}"
            SelectionMode="Extended"
            KeyDown="LogListView_KeyDown"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="Transparent"
            CornerRadius="8"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            Padding="12"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            ScrollViewer.HorizontalScrollBarVisibility="Auto">

            <ListView.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Копировать выделенное" Click="CopySelectedLogs_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8C8;" FontFamily="Segoe Fluent Icons" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Копировать все логи" Command="{x:Bind ViewModel.CopyAllLogsCommand}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8D8;" FontFamily="Segoe Fluent Icons" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Выделить всё" Click="SelectAllLogs_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8B3;" FontFamily="Segoe Fluent Icons" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </ListView.ContextFlyout>
            
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:LogItem">
                    <!-- Вывод строки лога шрифтом фиксированной ширины Consolas -->
                    <TextBlock 
                        Text="{x:Bind Message}" 
                        Foreground="{x:Bind Level, Converter={StaticResource LogLevelToBrushConverter}}"
                        FontFamily="Consolas"
                        FontSize="13"
                        TextWrapping="Wrap" />
                </DataTemplate>
            </ListView.ItemTemplate>
            
            <ListView.ItemContainerStyle>
                <!-- Настройка красивого построчного выделения элементов Fluent Design -->
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="24"/>
                    <Setter Property="Padding" Value="8,3,8,3"/>
                    <Setter Property="Margin" Value="0,1,0,1"/>
                    <Setter Property="CornerRadius" Value="4"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</Page>
