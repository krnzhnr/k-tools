<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="KTools_App.UI.Pages.TimingCalculatorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Кастомный заголовок окна -->
        <TitleBar x:Name="AppTitleBar" Title="Калькулятор сдвига таймингов" Grid.Row="0">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- Основное содержимое страницы -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="36,12,36,36" Spacing="28" MaxWidth="800" HorizontalAlignment="Left">
                
                <StackPanel Spacing="4">
                    <TextBlock Text="Калькулятор сдвига таймингов" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Вычисление разницы во времени между сэмплами для корректировки синхронизации аудио и субтитров." 
                               FontSize="13" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Блок полей ввода времени -->
                <Grid ColumnSpacing="24" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <!-- Оригинальное время -->
                    <StackPanel Grid.Column="0" Spacing="8">
                        <TextBlock Text="Оригинальное время (было)" 
                                   FontWeight="SemiBold" 
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBox x:Name="TimeBeforeBox" 
                                 Text="0:00:00.00" 
                                 FontFamily="Consolas, Courier New, monospace" 
                                 FontSize="16" 
                                 Width="180" 
                                 HorizontalAlignment="Left"
                                 TextAlignment="Center"
                                 SelectionStart="0"
                                 SelectionLength="0"
                                 MaxLength="10"
                                 PreviewKeyDown="TimeBox_PreviewKeyDown"
                                 SelectionChanged="TimeBox_SelectionChanged"
                                 LostFocus="TimeBox_LostFocus" />
                    </StackPanel>

                    <!-- Новое время -->
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock Text="Новое время (стало)" 
                                   FontWeight="SemiBold" 
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBox x:Name="TimeAfterBox" 
                                 Text="0:00:00.00" 
                                 FontFamily="Consolas, Courier New, monospace" 
                                 FontSize="16" 
                                 Width="180" 
                                 HorizontalAlignment="Left"
                                 TextAlignment="Center"
                                 SelectionStart="0"
                                 SelectionLength="0"
                                 MaxLength="10"
                                 PreviewKeyDown="TimeBox_PreviewKeyDown"
                                 SelectionChanged="TimeBox_SelectionChanged"
                                 LostFocus="TimeBox_LostFocus" />
                    </StackPanel>
                </Grid>

                <!-- Кнопка очистки -->
                <Button Content="Сбросить поля" 
                        Click="ResetButton_Click" 
                        Style="{ThemeResource DefaultButtonStyle}"
                        HorizontalAlignment="Left" />

                <!-- Блок результатов вычислений -->
                <Border CornerRadius="8" 
                        Padding="24" 
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1">
                    <StackPanel Spacing="20">
                        <TextBlock Text="Результат расчета сдвига" 
                                   FontSize="16" 
                                   FontWeight="SemiBold" 
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        
                        <!-- Абсолютный сдвиг (Aegisub Format) -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Сдвиг для Aegisub:" 
                                       FontSize="12" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Grid ColumnSpacing="12" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock x:Name="ResultTimeBlock" 
                                           Text="0:00:00.00" 
                                           FontFamily="Consolas, Courier New, monospace" 
                                           FontSize="32" 
                                           FontWeight="Bold" 
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" 
                                           Grid.Column="0" 
                                           VerticalAlignment="Center" />
                                
                                <Button Click="CopyResult_Click" 
                                        Grid.Column="1" 
                                        VerticalAlignment="Center" 
                                        Style="{ThemeResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="16" />
                                        <TextBlock Text="Копировать" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Направление сдвига -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Направление сдвига:" 
                                       FontSize="12" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel x:Name="DirectionPanel" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon x:Name="DirectionIcon" Glyph="&#xE72A;" FontSize="18" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                <TextBlock x:Name="DirectionTextBlock" 
                                           Text="Нет изменений" 
                                           FontSize="15" 
                                           FontWeight="SemiBold" 
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Дополнительно: сдвиг в миллисекундах (для аудио) -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Сдвиг в миллисекундах:" 
                                       FontSize="12" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Grid ColumnSpacing="12" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ResultMsBlock" 
                                           Text="0 ms" 
                                           FontFamily="Consolas, Courier New, monospace" 
                                           FontSize="18" 
                                           FontWeight="SemiBold" 
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" 
                                           Grid.Column="0" 
                                           VerticalAlignment="Center" />
                                <Button Click="CopyMs_Click" 
                                        Grid.Column="1" 
                                        Style="{ThemeResource DefaultButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="16" />
                                        <TextBlock Text="Копировать мс" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
