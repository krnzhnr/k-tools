<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="KTools_App.UI.Pages.TimingCalculatorPage"
    x:DataType="pages:TimingCalculatorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="using:KTools_App.UI.Pages"
    mc:Ignorable="d"
    IsTabStop="True"
    SizeChanged="Page_SizeChanged">

    <Grid>
        <!-- Основное содержимое страницы центрировано по горизонтали -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="36,24,36,36" Spacing="28" MaxWidth="600" HorizontalAlignment="Center">

                <!-- Блок полей ввода времени в ряд -->
                <StackPanel x:Name="InputsPanel" Orientation="Horizontal" Spacing="24" HorizontalAlignment="Center">
                    <!-- Оригинальное время -->
                    <StackPanel Spacing="8" Width="230">
                        <TextBlock Text="Текущий тайминг" 
                                   FontWeight="SemiBold" 
                                   HorizontalAlignment="Left"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TimeBeforeBox" 
                                     Text="0:00:00.000" 
                                     FontFamily="Consolas, Courier New, monospace" 
                                     FontSize="16" 
                                     HorizontalAlignment="Stretch"
                                     HorizontalContentAlignment="Center"
                                     SelectionStart="0"
                                     SelectionLength="0"
                                     MaxLength="11"
                                     PreviewKeyDown="TimeBox_PreviewKeyDown"
                                     SelectionChanged="TimeBox_SelectionChanged"
                                     LostFocus="TimeBox_LostFocus"
                                     Grid.Column="0" />
                            <Button Click="PasteBefore_Click" 
                                    Grid.Column="1"
                                    Width="36"
                                    Height="32"
                                    Padding="0"
                                    ToolTipService.ToolTip="Вставить из буфера обмена"
                                    Style="{ThemeResource DefaultButtonStyle}">
                                <FontIcon Glyph="&#xE77F;" FontSize="14" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Новое время -->
                    <StackPanel Spacing="8" Width="230">
                        <TextBlock Text="Целевой тайминг" 
                                   FontWeight="SemiBold" 
                                   HorizontalAlignment="Left"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TimeAfterBox" 
                                     Text="0:00:00.000" 
                                     FontFamily="Consolas, Courier New, monospace" 
                                     FontSize="16" 
                                     HorizontalAlignment="Stretch"
                                     HorizontalContentAlignment="Center"
                                     SelectionStart="0"
                                     SelectionLength="0"
                                     MaxLength="11"
                                     PreviewKeyDown="TimeBox_PreviewKeyDown"
                                     SelectionChanged="TimeBox_SelectionChanged"
                                     LostFocus="TimeBox_LostFocus"
                                     Grid.Column="0" />
                            <Button Click="PasteAfter_Click" 
                                    Grid.Column="1"
                                    Width="36"
                                    Height="32"
                                    Padding="0"
                                    ToolTipService.ToolTip="Вставить из буфера обмена"
                                    Style="{ThemeResource DefaultButtonStyle}">
                                <FontIcon Glyph="&#xE77F;" FontSize="14" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- Кнопка очистки по центру -->
                <Button Content="Сбросить поля" 
                        Click="ResetButton_Click" 
                        Style="{ThemeResource DefaultButtonStyle}"
                        HorizontalAlignment="Center" />

                <!-- Блок результатов вычислений растягивается на всю ширину контейнера (600px) -->
                <Border CornerRadius="8" 
                        Padding="24" 
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1"
                        HorizontalAlignment="Stretch">
                    <StackPanel Spacing="24" HorizontalAlignment="Center">
                        <TextBlock Text="Результат расчета сдвига" 
                                   FontSize="16" 
                                   FontWeight="SemiBold" 
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        
                        <!-- Абсолютный сдвиг (Aegisub / Субтитры Format) -->
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <TextBlock Text="Сдвиг для Aegisub / таймингов:" 
                                       FontSize="12" 
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                <TextBlock x:Name="ResultTimeBlock" 
                                           Text="0:00:00.000" 
                                           FontFamily="Consolas, Courier New, monospace" 
                                           FontSize="32" 
                                           FontWeight="Bold" 
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" 
                                           VerticalAlignment="Center" />
                                
                                <Button Click="CopyResult_Click" 
                                        VerticalAlignment="Center" 
                                        Style="{ThemeResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="16" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- Направление сдвига -->
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <TextBlock Text="Нужно сдвинуть:" 
                                       FontSize="12" 
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel x:Name="DirectionPanel" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <FontIcon x:Name="DirectionIcon" Glyph="&#xE72A;" FontSize="18" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                <TextBlock x:Name="DirectionTextBlock" 
                                           Text="Нет изменений" 
                                           FontSize="15" 
                                           FontWeight="SemiBold" 
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Дополнительно: сдвиг в миллисекундах (для аудио) -->
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <TextBlock Text="Сдвиг в миллисекундах:" 
                                       FontSize="12" 
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                <TextBlock x:Name="ResultMsBlock" 
                                           Text="0 ms" 
                                           FontFamily="Consolas, Courier New, monospace" 
                                           FontSize="18" 
                                           FontWeight="SemiBold" 
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" 
                                           VerticalAlignment="Center" />
                                <Button Click="CopyMs_Click" 
                                        Style="{ThemeResource DefaultButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="16" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- История последних расчётов -->
                <Border CornerRadius="8"
                        Padding="24"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Stretch">
                    <StackPanel Spacing="12" HorizontalAlignment="Stretch">
                        <TextBlock Text="История расчётов"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="EmptyHistoryText"
                                   Text="История пуста"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ItemsControl x:Name="HistoryList"
                                      ItemsSource="{x:Bind HistoryItems, Mode=OneWay}"
                                      AutomationProperties.Name="История расчётов">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="pages:TimingHistoryEntry">
                                    <Grid Margin="0,0,0,8">
                                        <Button Click="HistoryCard_Click"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                Padding="12,8,12,8"
                                                CornerRadius="8"
                                                ToolTipService.ToolTip="Подставить значения в поля ввода"
                                                AutomationProperties.Name="Подставить значения из истории"
                                                Style="{ThemeResource DefaultButtonStyle}">
                                            <Grid ColumnSpacing="12" RowSpacing="2" VerticalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind ShiftAegisub, Mode=OneTime}"
                                                           FontFamily="Consolas, Courier New, monospace"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                           VerticalAlignment="Center" />
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE72A;" FontSize="16"
                                                              Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                              Visibility="{x:Bind IsForward, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <FontIcon Glyph="&#xE72B;" FontSize="16"
                                                              Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                              Visibility="{x:Bind IsBackward, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <FontIcon Glyph="&#xE73E;" FontSize="16"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                              Visibility="{x:Bind IsMatch, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <TextBlock Text="{x:Bind Direction, Mode=OneTime}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                </StackPanel>
                                                <TextBlock Grid.Row="1" Grid.Column="0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center">
                                                    <Run Text="{x:Bind Before, Mode=OneTime}" /><Run Text=" → " /><Run Text="{x:Bind After, Mode=OneTime}" /><Run Text=" · " /><Run Text="{x:Bind ShiftMsText, Mode=OneTime}" />
                                                </TextBlock>
                                                <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Click="DeleteHistoryEntry_Click"
                                                        VerticalAlignment="Center"
                                                        Width="36"
                                                        Height="32"
                                                        Padding="0"
                                                        ToolTipService.ToolTip="Удалить запись"
                                                        AutomationProperties.Name="Удалить запись из истории"
                                                        AutomationProperties.AutomationId="DeleteHistoryEntryButton"
                                                        Style="{ThemeResource DefaultButtonStyle}">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                                </Button>
                                                <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Click="CopyHistoryEntry_Click"
                                                        VerticalAlignment="Center"
                                                        Width="36"
                                                        Height="32"
                                                        Padding="0"
                                                        ToolTipService.ToolTip="Скопировать сдвиг"
                                                        AutomationProperties.Name="Скопировать сдвиг из истории"
                                                        AutomationProperties.AutomationId="CopyHistoryEntryButton"
                                                        Style="{ThemeResource DefaultButtonStyle}">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                                </Button>
                                                <FontIcon Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" Glyph="&#xE76C;" FontSize="12"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                          VerticalAlignment="Center"
                                                          AutomationProperties.AccessibilityView="Raw" />
                                            </Grid>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="ClearHistoryButton"
                                Content="Очистить историю"
                                Click="ClearHistory_Click"
                                Style="{ThemeResource DefaultButtonStyle}"
                                HorizontalAlignment="Center"
                                AutomationProperties.Name="Очистить историю расчётов"
                                AutomationProperties.AutomationId="ClearHistoryButton" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
