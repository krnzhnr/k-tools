<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="KTools_App.UI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:community="using:CommunityToolkit.WinUI.Controls"
    xmlns:viewmodels="using:KTools_App.ViewModels"
    x:DataType="viewmodels:SettingsViewModel"
    mc:Ignorable="d"
    NavigationCacheMode="Disabled">



    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            Padding="36,12,36,36"
            HorizontalAlignment="Stretch"
            Spacing="20">

            <!-- Раздел: Общие параметры -->
            <StackPanel Spacing="8">
                <TextBlock
                    Margin="0,0,0,8"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="Общие параметры" />

                <!-- Флажок перезаписи файлов -->
                <community:SettingsCard
                    Padding="16,12,16,12"
                    Description="Автоматически перезаписывать файлы с одинаковыми именами без запроса подтверждения"
                    Header="Перезаписывать существующие файлы">
                    <ToggleSwitch
                        x:Name="OverwriteToggle"
                        OffContent="Выкл"
                        OnContent="Вкл"
                        IsOn="{x:Bind ViewModel.OverwriteExisting, Mode=TwoWay}" />
                </community:SettingsCard>

                <!-- Очищать ли очередь при добавлении -->
                <community:SettingsCard
                    Padding="16,12,16,12"
                    Description="Автоматически сбрасывать предыдущую очередь файлов при добавлении новых"
                    Header="Очищать очередь при добавлении">
                    <ToggleSwitch
                        x:Name="ClearListToggle"
                        OffContent="Выкл"
                        OnContent="Вкл"
                        IsOn="{x:Bind ViewModel.ClearListOnAdd, Mode=TwoWay}" />
                </community:SettingsCard>

                <!-- Интеграция с контекстным меню Проводника -->
                <community:SettingsCard
                    Padding="16,12,16,12"
                    Description="Добавить пункт 'Открыть в K-Tools' с выбором скрипта в контекстное меню Проводника"
                    Header="Интеграция с Проводником Windows">
                    <ToggleSwitch
                        x:Name="ContextMenuToggle"
                        OffContent="Выкл"
                        OnContent="Вкл"
                        IsOn="{x:Bind ViewModel.IsContextMenuEnabled, Mode=TwoWay}" />
                </community:SettingsCard>

                <!-- Регулировка максимального параллелизма (через SettingsExpander) -->
                <community:SettingsExpander
                    Padding="16,12,16,12"
                    Description="Выполнять обработку очереди файлов в несколько фоновых потоков одновременно"
                    Header="Параллельная обработка файлов"
                    IsExpanded="False">
                    <community:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </community:SettingsExpander.HeaderIcon>
                    <ToggleSwitch
                        x:Name="EnableParallelToggle"
                        OffContent="Выкл"
                        OnContent="Вкл"
                        IsOn="{x:Bind ViewModel.EnableParallel, Mode=TwoWay}" />

                    <community:SettingsExpander.Items>
                        <community:SettingsCard
                            Header="Количество одновременных потоков"
                            Description="Задайте лимит параллельно выполняемых скриптов (не более числа логических процессоров)"
                            IsEnabled="{x:Bind ViewModel.EnableParallel, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock
                                    x:Name="ParallelValueText"
                                    Width="24"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.MaxParallelTasks, Mode=OneWay}" />
                                <Slider
                                    x:Name="ParallelSlider"
                                    Width="200"
                                    VerticalAlignment="Center"
                                    Maximum="{x:Bind ViewModel.MaxParallelLimit, Mode=OneWay}"
                                    Minimum="0"
                                    Value="{x:Bind ViewModel.MaxParallelTasks, Mode=TwoWay}"
                                    TickFrequency="1"
                                    TickPlacement="Outside"
                                    SnapsTo="Ticks" />
                            </StackPanel>
                        </community:SettingsCard>
                    </community:SettingsExpander.Items>
                </community:SettingsExpander>

                <!-- Автоматическое создание подпапки (через SettingsExpander) -->
                <community:SettingsExpander
                    Padding="16,12,16,12"
                    Description="Всегда создавать подпапку результатов в каталоге исходных файлов"
                    Header="Создавать подпапку автоматически"
                    IsExpanded="False">
                    <community:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </community:SettingsExpander.HeaderIcon>
                    <ToggleSwitch
                        x:Name="AutoSubfolderToggle"
                        OffContent="Выкл"
                        OnContent="Вкл"
                        IsOn="{x:Bind ViewModel.UseAutoSubfolder, Mode=TwoWay}" />

                    <community:SettingsExpander.Items>
                        <community:SettingsCard
                            Header="Имя подпапки"
                            Description="Укажите название создаваемой подпапки для результатов обработки"
                            IsEnabled="{x:Bind ViewModel.UseAutoSubfolder, Mode=OneWay}">
                            <TextBox
                                x:Name="SubfolderNameTextBox"
                                Width="250"
                                PlaceholderText="KTools_Result"
                                Text="{x:Bind ViewModel.DefaultOutputSubfolder, Mode=TwoWay}" />
                        </community:SettingsCard>
                    </community:SettingsExpander.Items>
                </community:SettingsExpander>

            </StackPanel>
            
            <!-- Раздел: Переименование выходных файлов -->
            <StackPanel Spacing="8">
                <TextBlock
                    Margin="0,8,0,8"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="Переименование выходных файлов" />

                <!-- Первый экспандер: Параметры переименования -->
                <community:SettingsExpander
                    Padding="16,12,16,12"
                    Description="Изменение названий готовых файлов с поддержкой регулярных выражений, шаблонов дат и автонумерации"
                    Header="Параметры переименования"
                    IsExpanded="False">
                    <community:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE8AC;" />
                    </community:SettingsExpander.HeaderIcon>
                    
                    <ToggleSwitch
                        x:Name="RenameRegexToggle"
                        OffContent="Выкл"
                        OnContent="Вкл"
                        IsOn="{x:Bind ViewModel.RenameEnableRegex, Mode=TwoWay}" />

                    <community:SettingsExpander.Items>
                        <community:SettingsCard Header="Использовать регулярные выражения" Description="Включает поиск и замену с использованием регулярных выражений">
                            <ToggleSwitch
                                OffContent="Выкл"
                                OnContent="Вкл"
                                IsOn="{x:Bind ViewModel.RenameUseRegex, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.RenameEnableRegex, Mode=OneWay}" />
                        </community:SettingsCard>

                        <community:SettingsCard Header="Учитывать регистр" Description="Включает поиск с учетом регистра символов">
                            <ToggleSwitch
                                OffContent="Выкл"
                                OnContent="Вкл"
                                IsOn="{x:Bind ViewModel.RenameCaseSensitive, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.RenameEnableRegex, Mode=OneWay}" />
                        </community:SettingsCard>

                        <community:SettingsCard Header="Найти" Description="Шаблон поиска. Поддерживает регулярные выражения.">
                            <Grid HorizontalAlignment="Right">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="RenameRegexSearchTextBox"
                                    Grid.Column="0"
                                    Width="250"
                                    PlaceholderText="Например:  - (\d+) или просто текст"
                                    Text="{x:Bind ViewModel.RenameRegexSearch, Mode=TwoWay}"
                                    IsEnabled="{x:Bind ViewModel.RenameEnableRegex, Mode=OneWay}" />
                                <Button
                                    x:Name="SearchHelpButton"
                                    Grid.Column="1"
                                    Content="&#xE946;"
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    Margin="8,0,0,0"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    IsEnabled="{x:Bind ViewModel.RenameEnableRegex, Mode=OneWay}" />
                            </Grid>
                        </community:SettingsCard>

                        <community:SettingsCard Header="Заменить на" Description="Строка замены. Поддерживает $1, $2, ${ruuidv4}, ${num}, ${num:3}, ${YYYY}, ${MM}, ${DD}">
                            <Grid HorizontalAlignment="Right">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="RenameRegexReplaceTextBox"
                                    Grid.Column="0"
                                    Width="250"
                                    PlaceholderText="Например:  - [$1] или серия_${num:2}"
                                    Text="{x:Bind ViewModel.RenameRegexReplace, Mode=TwoWay}"
                                    IsEnabled="{x:Bind ViewModel.RenameEnableRegex, Mode=OneWay}" />
                                <Button
                                    x:Name="ReplaceHelpButton"
                                    Grid.Column="1"
                                    Content="&#xE946;"
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    Margin="8,0,0,0"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    IsEnabled="{x:Bind ViewModel.RenameEnableRegex, Mode=OneWay}" />
                            </Grid>
                        </community:SettingsCard>
                    </community:SettingsExpander.Items>
                </community:SettingsExpander>

                <!-- Второй экспандер: Пользовательские шаблоны подсказок -->
                <community:SettingsExpander
                    Padding="16,12,16,12"
                    Description="Настройка пользовательских вариантов для меню быстрого копирования шаблонов"
                    Header="Шаблоны подсказок"
                    IsExpanded="False">
                    <community:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE8B9;" />
                    </community:SettingsExpander.HeaderIcon>
                    
                    <community:SettingsExpander.Items>
                        <community:SettingsCard
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            HorizontalContentAlignment="Stretch"
                            IsEnabled="{x:Bind ViewModel.RenameEnableRegex, Mode=OneWay}">
                            <StackPanel Spacing="16" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Шаблоны поиска" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Style="{ThemeResource DefaultButtonStyle}" Click="AddSearchTemplate_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                                <TextBlock Text="Добавить" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <StackPanel x:Name="SearchTemplatesContainer" Spacing="6" HorizontalAlignment="Stretch" />
                                </StackPanel>

                                <MenuFlyoutSeparator Margin="0,4,0,4"/>

                                <StackPanel Spacing="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Шаблоны автозамены" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Style="{ThemeResource DefaultButtonStyle}" Click="AddReplaceTemplate_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                                <TextBlock Text="Добавить" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <StackPanel x:Name="ReplaceTemplatesContainer" Spacing="6" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </StackPanel>
                        </community:SettingsCard>
                    </community:SettingsExpander.Items>
                </community:SettingsExpander>
            </StackPanel>

            <!-- Раздел: Персонализация -->
            <StackPanel Spacing="8">
                <TextBlock
                    Margin="0,8,0,8"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="Персонализация" />

                <!-- Выбор цветовой темы -->
                <community:SettingsCard
                    Padding="16,12,16,12"
                    Description="Выберите визуальную тему интерфейса приложения (требуется перезапуск)"
                    Header="Тема оформления">
                    <ComboBox
                        x:Name="ThemeComboBox"
                        Width="160"
                        SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}">
                        <ComboBoxItem
                            Tag="Dark"
                            Content="Темная" />
                        <ComboBoxItem
                            Tag="Light"
                            Content="Светлая" />
                    </ComboBox>
                </community:SettingsCard>

                <!-- Эффект прозрачности (Backdrop) -->
                <community:SettingsCard
                    Padding="16,12,16,12"
                    Description="Выберите эффект оформления фона окон приложения (Mica или Acrylic)"
                    Header="Эффект фона окон">
                    <ComboBox
                        x:Name="BackdropComboBox"
                        Width="160"
                        SelectedIndex="{x:Bind ViewModel.SelectedBackdropIndex, Mode=TwoWay}">
                        <ComboBoxItem
                            Tag="Mica"
                            Content="Mica" />
                        <ComboBoxItem
                            Tag="Acrylic"
                            Content="Acrylic" />
                    </ComboBox>
                </community:SettingsCard>
            </StackPanel>

            <!-- Раздел: Логирование -->
            <StackPanel Spacing="8">
                <TextBlock
                    Margin="0,8,0,8"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="Логирование" />

                <!-- Отображать ли вкладку логов -->
                <community:SettingsCard
                    Padding="16,12,16,12"
                    Description="Показывать вкладку «Логи» в боковом меню приложения для мониторинга в реальном времени"
                    Header="Отображать монитор журналов">
                    <ToggleSwitch
                        x:Name="ShowLogsTabToggle"
                        OffContent="Выкл"
                        OnContent="Вкл"
                        IsOn="{x:Bind ViewModel.ShowLogsTab, Mode=TwoWay}" />
                </community:SettingsCard>

                <!-- Выбор папки для сохранения логов -->
                <community:SettingsCard
                    Padding="16,12,16,12"
                    Description="Каталог на диске для автоматического сохранения файлов логов программы"
                    Header="Путь к папке логов">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBox
                            x:Name="LogDirTextBox"
                            Width="300"
                            VerticalAlignment="Center"
                            IsReadOnly="True"
                            Text="{x:Bind ViewModel.LogDir, Mode=OneWay}"
                            PlaceholderText="Используется папка по умолчанию" />
                        <Button
                            x:Name="BrowseLogDirButton"
                            VerticalAlignment="Center"
                            Click="BrowseLogDirButton_Click"
                            Content="Обзор" />
                    </StackPanel>
                </community:SettingsCard>
            </StackPanel>

            <!-- Раздел: Обновления -->
            <StackPanel Spacing="8">
                <TextBlock
                    Margin="0,8,0,8"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="Обновления" />

                <!-- Автоматическая проверка обновлений -->
                <community:SettingsCard
                    Padding="16,12,16,12"
                    Description="Выполнять поиск новой версии K-Tools на GitHub при каждом запуске"
                    Header="Автоматический поиск обновлений">
                    <ToggleSwitch
                        x:Name="AutoCheckUpdatesToggle"
                        OffContent="Выкл"
                        OnContent="Вкл"
                        IsOn="{x:Bind ViewModel.AutoCheckUpdates, Mode=TwoWay}" />
                </community:SettingsCard>

                <!-- Участие в бета-тестировании -->
                <community:SettingsCard
                    Padding="16,12,16,12"
                    Description="Включать предварительные (beta) версии программы в результаты поиска обновлений"
                    Header="Участвовать в бета-тестировании">
                    <ToggleSwitch
                        x:Name="IncludePreReleasesToggle"
                        OffContent="Выкл"
                        OnContent="Вкл"
                        IsOn="{x:Bind ViewModel.IncludePreReleases, Mode=TwoWay}" />
                </community:SettingsCard>

                <!-- Ручная проверка обновлений (скрывается, если найдено обновление) -->
                <community:SettingsCard
                    Padding="16,12,16,12"
                    Description="Запустить проверку наличия свежих обновлений приложения на GitHub"
                    Header="Проверить наличие обновлений"
                    Visibility="{x:Bind ViewModel.IsUpdateAvailable, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ProgressRing
                            x:Name="UpdateProgressRing"
                            Width="20"
                            Height="20"
                            VerticalAlignment="Center"
                            IsActive="{x:Bind ViewModel.IsChecking, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsChecking, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Button
                            x:Name="CheckUpdatesButton"
                            Command="{x:Bind ViewModel.CheckForUpdatesCommand}"
                            Content="Проверить"
                            IsEnabled="{x:Bind ViewModel.IsChecking, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" />
                    </StackPanel>
                </community:SettingsCard>

                <!-- Зелёная карточка с доступным обновлением (показывается взамен проверки обновлений) -->
                <community:SettingsCard
                    Padding="16,12,16,12"
                    Header="{x:Bind ViewModel.UpdateStatusText, Mode=OneWay}"
                    Description="{x:Bind ViewModel.NewUpdateInfo.Title, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsUpdateAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    BorderBrush="{ThemeResource SuccessStrokeBrush}"
                    BorderThickness="1">
                    <community:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE930;" Foreground="{ThemeResource SuccessStrokeBrush}" />
                    </community:SettingsCard.HeaderIcon>
                    <Button
                        x:Name="InstallUpdateButton"
                        Command="{x:Bind ViewModel.DownloadAndInstallUpdateCommand}"
                        Content="Скачать и установить"
                        Style="{ThemeResource AccentButtonStyle}"
                        VerticalAlignment="Center"
                        IsEnabled="{x:Bind ViewModel.IsDownloading, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" />
                </community:SettingsCard>
            </StackPanel>

            <!-- Прогресс скачивания (отображается только в процессе загрузки под блоком настроек обновлений) -->
            <StackPanel
                Visibility="{x:Bind ViewModel.IsDownloading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                Spacing="4"
                Margin="0,8,0,0">
                <ProgressBar
                    x:Name="DownloadProgressBar"
                    Minimum="0"
                    Maximum="100"
                    Value="{x:Bind ViewModel.DownloadProgress, Mode=OneWay}" />
                <TextBlock
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Right">
                    <Run Text="Скачивание... " />
                    <Run Text="{x:Bind ViewModel.DownloadProgress, Mode=OneWay}" />
                    <Run Text="%" />
                </TextBlock>
            </StackPanel>

            <!-- Раздел: Сброс и обслуживание -->
            <StackPanel Spacing="8">
                <TextBlock
                    Margin="0,8,0,8"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="Обслуживание" />

                <!-- Кнопка сброса настроек -->
                <community:SettingsCard
                    Padding="16,12,16,12"
                    Description="Удалить файл конфигурации и вернуть все настройки приложения по умолчанию"
                    Header="Сбросить все параметры">
                    <Button
                        x:Name="ResetSettingsButton"
                        Command="{x:Bind ViewModel.ResetSettingsCommand}"
                        Content="Сбросить настройки"
                        Style="{StaticResource DefaultButtonStyle}" />
                </community:SettingsCard>
            </StackPanel>

            <!-- Блок о программе -->
            <community:SettingsExpander
                Header="K-Tools C# Edition"
                Description="© 2026. Все права защищены."
                IsExpanded="False">
                <community:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE946;" />
                </community:SettingsExpander.HeaderIcon>

                <Button
                    Command="{x:Bind ViewModel.VersionClickedCommand}"
                    Content="{x:Bind ViewModel.CurrentVersionText, Mode=OneWay}"
                    Background="Transparent"
                    BorderThickness="0"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Padding="4,2,4,2" />

                <community:SettingsExpander.Items>
                    <community:SettingsCard>
                        <community:SettingsCard.Header>
                            <HyperlinkButton
                                Content="Исходный код (GitHub)"
                                NavigateUri="https://github.com/krnzhnr/k-tools" />
                        </community:SettingsCard.Header>
                    </community:SettingsCard>
                    <community:SettingsCard>
                        <community:SettingsCard.Header>
                            <HyperlinkButton
                                Content="Сообщить о проблеме"
                                NavigateUri="https://github.com/krnzhnr/k-tools/issues" />
                        </community:SettingsCard.Header>
                    </community:SettingsCard>
                    <community:SettingsCard>
                        <community:SettingsCard.Header>
                            <HyperlinkButton
                                Content="Лицензия MIT"
                                NavigateUri="https://github.com/krnzhnr/k-tools/blob/main/LICENSE" />
                        </community:SettingsCard.Header>
                    </community:SettingsCard>
                </community:SettingsExpander.Items>
            </community:SettingsExpander>

            <!-- Раздел: Параметры отладки -->
            <community:SettingsExpander
                Header="Параметры отладки"
                Description="Временные инструменты для тестирования и отладки приложения"
                Visibility="{x:Bind ViewModel.IsDebugSettingsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                IsExpanded="True"
                Margin="0,12,0,0">
                <community:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xEBE8;" />
                </community:SettingsExpander.HeaderIcon>

                <community:SettingsExpander.Items>
                    <community:SettingsCard Header="Имитировать старую версию" Description="Принудительно возвращает версию 1.0.0 при проверке обновлений для тестирования уведомлений">
                        <ToggleSwitch
                            x:Name="SimulateOldVersionToggle"
                            OffContent="Выкл"
                            OnContent="Вкл"
                            IsOn="{x:Bind ViewModel.DebugSimulateOldVersion, Mode=TwoWay}" />
                    </community:SettingsCard>
                </community:SettingsExpander.Items>
            </community:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
