<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="KTools_App.UI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:community="using:CommunityToolkit.WinUI.Controls"
    xmlns:viewmodels="using:KTools_App.ViewModels"
    x:DataType="viewmodels:SettingsViewModel"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="SuccessStrokeBrush" Color="#107C41" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SuccessStrokeBrush" Color="#6BC285" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            Padding="36,12,36,36"
            HorizontalAlignment="Stretch"
            Spacing="20">

            <!-- Раздел: Общие параметры -->
            <StackPanel Spacing="8">
                <TextBlock
                    Margin="0,0,0,8"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="Общие параметры" />

                <!-- Флажок перезаписи файлов -->
                <community:SettingsCard
                    Padding="16,12,16,12"
                    Description="Автоматически перезаписывать файлы с одинаковыми именами без запроса подтверждения"
                    Header="Перезаписывать существующие файлы">
                    <ToggleSwitch
                        x:Name="OverwriteToggle"
                        OffContent="Выкл"
                        OnContent="Вкл"
                        IsOn="{x:Bind ViewModel.OverwriteExisting, Mode=TwoWay}" />
                </community:SettingsCard>

                <!-- Очищать ли очередь при добавлении -->
                <community:SettingsCard
                    Padding="16,12,16,12"
                    Description="Автоматически сбрасывать предыдущую очередь файлов при добавлении новых"
                    Header="Очищать очередь при добавлении">
                    <ToggleSwitch
                        x:Name="ClearListToggle"
                        OffContent="Выкл"
                        OnContent="Вкл"
                        IsOn="{x:Bind ViewModel.ClearListOnAdd, Mode=TwoWay}" />
                </community:SettingsCard>

                <!-- Регулировка максимального параллелизма -->
                <community:SettingsCard
                    Padding="16,12,16,12"
                    Description="Максимальное число одновременно запущенных фоновых потоков обработки"
                    Header="Максимальный параллелизм">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="12">
                        <TextBlock
                            x:Name="ParallelValueText"
                            Width="24"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.MaxParallelTasks, Mode=OneWay}" />
                        <Slider
                            x:Name="ParallelSlider"
                            Width="200"
                            VerticalAlignment="Center"
                            Maximum="{x:Bind ViewModel.MaxParallelLimit, Mode=OneWay}"
                            Minimum="1"
                            Value="{x:Bind ViewModel.MaxParallelTasks, Mode=TwoWay}"
                            SnapsTo="StepValues"
                            StepFrequency="1"
                            TickFrequency="1" />
                    </StackPanel>
                </community:SettingsCard>

                <!-- Название подпапки экспорта -->
                <community:SettingsCard
                    Padding="16,12,16,12"
                    Description="Имя подпапки, создаваемой по умолчанию в директории сохранения результатов"
                    Header="Имя папки результатов">
                    <TextBox
                        x:Name="SubfolderTextBox"
                        Width="200"
                        Text="{x:Bind ViewModel.DefaultOutputSubfolder, Mode=TwoWay}" />
                </community:SettingsCard>

                <!-- Автоматическое создание подпапки -->
                <community:SettingsCard
                    Padding="16,12,16,12"
                    Description="Всегда создавать подпапку результатов в каталоге исходных файлов"
                    Header="Создавать подпапку автоматически">
                    <ToggleSwitch
                        x:Name="AutoSubfolderToggle"
                        OffContent="Выкл"
                        OnContent="Вкл"
                        IsOn="{x:Bind ViewModel.UseAutoSubfolder, Mode=TwoWay}" />
                </community:SettingsCard>
            </StackPanel>

            <!-- Раздел: Персонализация -->
            <StackPanel Spacing="8">
                <TextBlock
                    Margin="0,8,0,8"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="Персонализация" />

                <!-- Выбор цветовой темы -->
                <community:SettingsCard
                    Padding="16,12,16,12"
                    Description="Выберите визуальную тему интерфейса приложения (требуется перезапуск)"
                    Header="Тема оформления">
                    <ComboBox
                        x:Name="ThemeComboBox"
                        Width="160"
                        SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}">
                        <ComboBoxItem
                            Tag="Dark"
                            Content="Темная" />
                        <ComboBoxItem
                            Tag="Light"
                            Content="Светлая" />
                    </ComboBox>
                </community:SettingsCard>

                <!-- Эффект прозрачности (Backdrop) -->
                <community:SettingsCard
                    Padding="16,12,16,12"
                    Description="Выберите эффект оформления фона окон приложения (Mica или Acrylic)"
                    Header="Эффект фона окон">
                    <ComboBox
                        x:Name="BackdropComboBox"
                        Width="160"
                        SelectedIndex="{x:Bind ViewModel.SelectedBackdropIndex, Mode=TwoWay}">
                        <ComboBoxItem
                            Tag="Mica"
                            Content="Mica" />
                        <ComboBoxItem
                            Tag="Acrylic"
                            Content="Acrylic" />
                    </ComboBox>
                </community:SettingsCard>
            </StackPanel>

            <!-- Раздел: Логирование -->
            <StackPanel Spacing="8">
                <TextBlock
                    Margin="0,8,0,8"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="Логирование" />

                <!-- Отображать ли вкладку логов -->
                <community:SettingsCard
                    Padding="16,12,16,12"
                    Description="Показывать вкладку «Логи» в боковом меню приложения для мониторинга в реальном времени"
                    Header="Отображать монитор журналов">
                    <ToggleSwitch
                        x:Name="ShowLogsTabToggle"
                        OffContent="Выкл"
                        OnContent="Вкл"
                        IsOn="{x:Bind ViewModel.ShowLogsTab, Mode=TwoWay}" />
                </community:SettingsCard>

                <!-- Выбор папки для сохранения логов -->
                <community:SettingsCard
                    Padding="16,12,16,12"
                    Description="Каталог на диске для автоматического сохранения файлов логов программы"
                    Header="Путь к папке логов">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBox
                            x:Name="LogDirTextBox"
                            Width="300"
                            VerticalAlignment="Center"
                            IsReadOnly="True"
                            Text="{x:Bind ViewModel.LogDir, Mode=OneWay}"
                            PlaceholderText="Используется папка по умолчанию" />
                        <Button
                            x:Name="BrowseLogDirButton"
                            VerticalAlignment="Center"
                            Click="BrowseLogDirButton_Click"
                            Content="Обзор" />
                    </StackPanel>
                </community:SettingsCard>
            </StackPanel>

            <!-- Раздел: Обновления -->
            <StackPanel Spacing="8">
                <TextBlock
                    Margin="0,8,0,8"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="Обновления" />

                <!-- Автоматическая проверка обновлений -->
                <community:SettingsCard
                    Padding="16,12,16,12"
                    Description="Выполнять поиск новой версии K-Tools на GitHub при каждом запуске"
                    Header="Автоматический поиск обновлений">
                    <ToggleSwitch
                        x:Name="AutoCheckUpdatesToggle"
                        OffContent="Выкл"
                        OnContent="Вкл"
                        IsOn="{x:Bind ViewModel.AutoCheckUpdates, Mode=TwoWay}" />
                </community:SettingsCard>

                <!-- Участие в бета-тестировании -->
                <community:SettingsCard
                    Padding="16,12,16,12"
                    Description="Включать предварительные (beta) версии программы в результаты поиска обновлений"
                    Header="Участвовать в бета-тестировании">
                    <ToggleSwitch
                        x:Name="IncludePreReleasesToggle"
                        OffContent="Выкл"
                        OnContent="Вкл"
                        IsOn="{x:Bind ViewModel.IncludePreReleases, Mode=TwoWay}" />
                </community:SettingsCard>

                <!-- Ручная проверка обновлений -->
                <community:SettingsCard
                    Padding="16,12,16,12"
                    Description="Запустить проверку наличия свежих обновлений приложения на GitHub"
                    Header="Проверить наличие обновлений">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ProgressRing
                            x:Name="UpdateProgressRing"
                            Width="20"
                            Height="20"
                            VerticalAlignment="Center"
                            IsActive="{x:Bind ViewModel.IsChecking, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsChecking, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Button
                            x:Name="CheckUpdatesButton"
                            Command="{x:Bind ViewModel.CheckForUpdatesCommand}"
                            Content="Проверить"
                            IsEnabled="{x:Bind ViewModel.IsChecking, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" />
                    </StackPanel>
                </community:SettingsCard>
            </StackPanel>

            <!-- Дополнительный блок проверки и загрузки обновлений -->
            <StackPanel
                Visibility="{x:Bind ViewModel.IsUpdateAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                Spacing="8">
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource SuccessStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.UpdateStatusText, Mode=OneWay}" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.NewUpdateInfo.Title, Mode=OneWay}" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            x:Name="InstallUpdateButton"
                            Command="{x:Bind ViewModel.DownloadAndInstallUpdateCommand}"
                            Content="Скачать и установить"
                            IsEnabled="{x:Bind ViewModel.IsDownloading, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                            Style="{StaticResource AccentButtonStyle}"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Прогресс скачивания -->
                <StackPanel
                    Visibility="{x:Bind ViewModel.IsDownloading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    Spacing="4"
                    Margin="4,0,4,0">
                    <ProgressBar
                        x:Name="DownloadProgressBar"
                        Minimum="0"
                        Maximum="100"
                        Value="{x:Bind ViewModel.DownloadProgress, Mode=OneWay}" />
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        HorizontalAlignment="Right">
                        <Run Text="Скачивание... " />
                        <Run Text="{x:Bind ViewModel.DownloadProgress, Mode=OneWay}" />
                        <Run Text="%" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <!-- Раздел: Сброс и обслуживание -->
            <StackPanel Spacing="8">
                <TextBlock
                    Margin="0,8,0,8"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="Обслуживание" />

                <!-- Кнопка сброса настроек -->
                <community:SettingsCard
                    Padding="16,12,16,12"
                    Description="Удалить файл конфигурации и вернуть все настройки приложения по умолчанию"
                    Header="Сбросить все параметры">
                    <Button
                        x:Name="ResetSettingsButton"
                        Command="{x:Bind ViewModel.ResetSettingsCommand}"
                        Content="Сбросить настройки"
                        Style="{StaticResource DefaultButtonStyle}" />
                </community:SettingsCard>
            </StackPanel>

            <!-- Блок о программе -->
            <Border
                Padding="16"
                Margin="0,20,0,0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <SymbolIcon
                        Width="40"
                        Height="40"
                        Margin="0,0,16,0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Symbol="Setting" />

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="4">
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="K-Tools C# Edition" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Версия 2.0.0 (WinAppSDK / WinUI 3)" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="Тестовая сборка" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
