<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="KTools_App.UI.Pages.WorkPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:KTools_App.ViewModels"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    x:DataType="viewmodels:WorkPanelViewModel"
    AllowDrop="True"
    DragOver="WorkPanel_DragOver"
    Drop="WorkPanel_Drop"
    mc:Ignorable="d">

    <Grid Padding="36,0,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Баннер недостающих зависимостей -->
            <RowDefinition Height="*" />    <!-- Основная рабочая область -->
            <RowDefinition Height="Auto" /> <!-- Нижняя панель управления -->
        </Grid.RowDefinitions>

        <InfoBar x:Name="DependencyWarningBar" 
                 Grid.Row="0"
                 Severity="Warning"
                 Title="Недостающие компоненты"
                 Message="{x:Bind ViewModel.DependencyWarningText, Mode=OneWay}"
                 IsOpen="{x:Bind ViewModel.IsDependencyWarningOpen, Mode=OneWay}"
                 IsClosable="False"
                 Margin="0,0,0,12">
            <InfoBar.ActionButton>
                <Button Content="Установить" Click="InstallDependencies_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- Двухвкладочный NavigationView-контейнер с поддержкой альбомного разделения -->
        <Grid x:Name="MainWorkGrid" Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <!-- Левая колонка: Файлы / Дорожки -->
                <ColumnDefinition x:Name="LeftColumn" Width="*" />
                <!-- Колонка разделителя: GridSplitter -->
                <ColumnDefinition x:Name="SeparatorColumn" Width="0" />
                <!-- Правая колонка: Закрепленные настройки -->
                <ColumnDefinition x:Name="RightColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- Левая область: Файлы и Дорожки -->
            <Grid x:Name="LeftAreaGrid" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Горизонтальное меню вкладок -->
                    <RowDefinition Height="Auto" /> <!-- Тонкий горизонтальный сепаратор -->
                    <RowDefinition Height="*" />    <!-- Активный контент выбранной вкладки -->
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <NavigationView x:Name="nvSample" 
                                    Grid.Column="0" 
                                    PaneDisplayMode="Top"
                                    IsSettingsVisible="False"
                                    IsBackButtonVisible="Collapsed"
                                    AlwaysShowHeader="False"
                                    SelectionChanged="nvSample_SelectionChanged"
                                    SelectionFollowsFocus="Enabled"
                                    Height="48"
                                    Margin="0"
                                    Padding="0">
                        <NavigationView.Resources>
                            <!-- Делаем фон области контента прозрачным -->
                            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                            <!-- Убираем рамку вокруг области контента -->
                            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                            <!-- Сбрасываем внутренние боковые отступы области контента NavigationView -->
                            <Thickness x:Key="NavigationViewContentMargin">0,0,0,0</Thickness>
                            <!-- Сбрасываем высоту и отступы заголовка NavigationView, чтобы убрать пустое пространство -->
                            <Thickness x:Key="NavigationViewHeaderMargin">0,0,0,0</Thickness>
                            <GridLength x:Key="NavigationViewHeaderRowHeight">0</GridLength>
                        </NavigationView.Resources>
                        <NavigationView.MenuItems>
                            <NavigationViewItem Icon="Document" Content="Файлы" x:Name="SamplePage1Item" Tag="files" />
                            <NavigationViewItem Icon="Setting" Content="Настройки" x:Name="SamplePage2Item" Tag="settings" />
                        </NavigationView.MenuItems>
                    </NavigationView>

                    <Button x:Name="PreviewButton"
                            Grid.Column="1"
                            Click="PreviewButton_Click"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"
                            Visibility="Collapsed">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Find" />
                                    <TextBlock Text="Предпросмотр..." />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </Grid>

                <!-- Сепаратор под вкладками -->
                <Border Grid.Row="1" 
                        Height="1" 
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" 
                        HorizontalAlignment="Stretch"
                        Margin="5,4,5,6" />

                <!-- Фрейм контента вкладок -->
                <Frame x:Name="contentFrame" 
                       Grid.Row="2" 
                       Margin="0" />
            </Grid>

            <!-- Вертикальный перетаскиваемый разделитель для альбомного режима -->
            <controls:GridSplitter x:Name="VerticalSeparator"
                                   Grid.Column="1"
                                   Width="12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Stretch"
                                   ResizeBehavior="PreviousAndNext"
                                   ResizeDirection="Columns"
                                   Background="Transparent"
                                   Visibility="Collapsed" />

            <!-- Правая область: всегда видимая панель Настроек (в альбомном режиме) -->
            <Grid x:Name="RightAreaGrid" Grid.Column="2" Visibility="Collapsed" Margin="8,0,0,0" SizeChanged="RightAreaGrid_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Заголовок настроек -->
                    <RowDefinition Height="Auto" /> <!-- Горизонтальный сепаратор -->
                    <RowDefinition Height="*" />    <!-- Правый фрейм для настроек -->
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Height="48">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <SymbolIcon Symbol="Setting" />
                        <TextBlock Text="Настройки" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Тонкий разделитель под заголовком настроек -->
                <Border Grid.Row="1" 
                        Height="1" 
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" 
                        HorizontalAlignment="Stretch"
                        Margin="5,4,5,6" />

                <!-- Фрейм контента для панели настроек справа -->
                <Frame x:Name="rightSettingsFrame" 
                       Grid.Row="2" 
                       Margin="0" />
            </Grid>
        </Grid>

        <!-- Фиксированная нижняя панель запуска и прогресса -->
        <Border Grid.Row="2" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8"
                Padding="24,12,24,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- 1 строка: Статус и Прогресс-бар -->
                    <RowDefinition Height="Auto" /> <!-- 2 строка: Путь, Обзор, Выполнить -->
                </Grid.RowDefinitions>

                <!-- Строка 1: Прогресс-бар и Статус (как в оригинале) -->
                <StackPanel Grid.Row="0" Margin="0,0,0,12" Spacing="4">
                    <TextBlock x:Name="StatusTextBlock" 
                               Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" 
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ProgressBar x:Name="GlobalProgressBar" 
                                 Maximum="100" 
                                 Value="{x:Bind ViewModel.GlobalProgressValue, Mode=OneWay}" 
                                 Height="4" 
                                 HorizontalAlignment="Stretch" />
                </StackPanel>

                <!-- Строка 2: Выбор пути, Обзор и Выполнить (как в оригинале) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Текстовое поле ввода пути -->
                    <TextBox x:Name="OutputPathTextBox" 
                             Grid.Column="0"
                             Text="{x:Bind ViewModel.OutputPath, Mode=TwoWay}"
                             IsEnabled="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                             PlaceholderText="{x:Bind ViewModel.OutputPathPlaceholder, Mode=OneWay}" 
                             IsSpellCheckEnabled="False"
                             VerticalAlignment="Center"
                             Height="36"
                             Margin="0,0,8,0" />

                    <!-- Кнопка Обзора -->
                    <Button Grid.Column="1"
                            Content="Обзор..." 
                            Click="BrowseFolder_Click" 
                            IsEnabled="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                            VerticalAlignment="Center"
                            Height="36"
                            Width="100"
                            Margin="0,0,12,0" />

                    <!-- Единая кнопка-переключатель запуска/отмены обработки -->
                    <StackPanel Grid.Column="2" 
                                Orientation="Horizontal" 
                                Spacing="8" 
                                VerticalAlignment="Center">
                        <Button x:Name="ActionButton" 
                                Content="Выполнить" 
                                Click="ActionButton_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                Width="140"
                                Height="36" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
