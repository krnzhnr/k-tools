<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="KTools_App.UI.AudioSyncWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Визуальная синхронизация аудиодорожек (Win2D)"
    mc:Ignorable="d">

    <Grid Padding="20" RowSpacing="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Заголовок и пояснение -->
        <StackPanel Grid.Row="0" Spacing="5">
            <TextBlock Text="Визуальная синхронизация дорожек" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Сопоставьте пики сигналов аудиодорожек. Используйте перетаскивание мышью или кнопки сдвига." 
                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Область нативных осциллограмм Win2D GPU -->
        <Grid Grid.Row="1" RowSpacing="10" x:Name="CanvasContainer">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 1. Исходная дорожка целевого видео -->
            <Border Grid.Row="0" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Целевое видео (Оригинал)" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#00E5FF" />
                    <canvas:CanvasControl x:Name="SourceCanvas" Grid.Row="1" CreateResources="SourceCanvas_CreateResources" Draw="SourceCanvas_Draw" PointerWheelChanged="Canvas_PointerWheelChanged" PointerPressed="Canvas_PointerPressed" PointerMoved="Canvas_PointerMoved" PointerReleased="Canvas_PointerReleased" />
                </Grid>
            </Border>

            <!-- 2. Пересаживаемая внешняя дорожка -->
            <Border Grid.Row="1" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Пересаживаемая дорожка (Сдвигаемая)" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#FF4081" />
                    <canvas:CanvasControl x:Name="TransplantCanvas" Grid.Row="1" CreateResources="TransplantCanvas_CreateResources" Draw="TransplantCanvas_Draw" PointerWheelChanged="Canvas_PointerWheelChanged" PointerPressed="Canvas_PointerPressed" PointerMoved="Canvas_PointerMoved" PointerReleased="Canvas_PointerReleased" />
                </Grid>
            </Border>
        </Grid>

        <!-- Панель точного управления сдвигом -->
        <StackPanel Grid.Row="2" Orientation="Vertical" Spacing="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                <Button Content="-100 мс" Click="OnShiftClick" Tag="-100" />
                <Button Content="-10 мс" Click="OnShiftClick" Tag="-10" />
                <Button Content="-1 мс" Click="OnShiftClick" Tag="-1" />
                <Button Content="Сброс (0 мс)" Click="OnResetClick" />
                <Button Content="+1 мс" Click="OnShiftClick" Tag="1" />
                <Button Content="+10 мс" Click="OnShiftClick" Tag="10" />
                <Button Content="+100 мс" Click="OnShiftClick" Tag="100" />
            </StackPanel>

            <Grid ColumnSpacing="20" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Визуальный сдвиг:" VerticalAlignment="Center" />
                    <NumberBox x:Name="ShiftNumberBox" Value="0" SpinButtonPlacementMode="Inline" SmallChange="1" LargeChange="10" ValueChanged="ShiftNumberBox_ValueChanged" Width="140" />
                    <TextBlock Text="мс" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Компенсация AAC:" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="-21.33 мс" VerticalAlignment="Center" FontWeight="Bold" Foreground="#FFB74D" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Фактический сдвиг:" VerticalAlignment="Center" FontWeight="Bold" />
                    <TextBlock x:Name="NetOffsetTextBlock" Text="-21.33 мс" VerticalAlignment="Center" FontWeight="Bold" Foreground="#81C784" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Нижная кнопка отмены и принятия -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
            <ProgressRing x:Name="LoadingRing" IsActive="False" Width="24" Height="24" Margin="0,0,10,0" />
            <TextBlock x:Name="StatusTextBlock" Text="" VerticalAlignment="Center" Margin="0,0,15,0" Style="{StaticResource CaptionTextBlockStyle}" />
            <Button Content="Отмена" Click="OnCancelClick" Width="100" />
            <Button Content="Применить сдвиг" Style="{StaticResource AccentButtonStyle}" Click="OnApplyClick" Width="160" x:Name="ApplyButton" />
        </StackPanel>
    </Grid>
</Window>
