<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="KTools_App.UI.Controls.StreamReplaceControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:KTools_App.UI.Controls"
    mc:Ignorable="d">

    <Grid Padding="0,16,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Заголовок (0) -->
            <RowDefinition Height="*" />    <!-- Рабочая область (1) -->
        </Grid.RowDefinitions>

        <!-- Заголовок панели подмены дорожек -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16" Spacing="4">
            <TextBlock x:Name="TitleTextBlock"
                       Text="Подмена дорожек в контейнере" 
                       FontSize="16" 
                       FontWeight="SemiBold" 
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock x:Name="DescriptionTextBlock"
                       Text="Назначьте внешние файлы-замены для внутренних аудио-, видео- или субтитров оригинального медиафайла." 
                       FontSize="12" 
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Основная область с разделением на две колонки -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" /> <!-- Левая: Карточка назначений -->
                <ColumnDefinition Width="1*" /> <!-- Правая: Список файлов-замен -->
            </Grid.ColumnDefinitions>

            <!-- Левая колонка: Назначение замен (с поддержкой Drag and Drop исходных файлов) -->
            <Border Grid.Column="0"
                    x:Name="TargetAssignmentsCardBorder"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,12,0"
                    AllowDrop="True"
                    DragOver="TargetCard_DragOver"
                    DragLeave="TargetCard_DragLeave"
                    Drop="TargetCard_Drop"
                    VerticalAlignment="Stretch">
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Универсальная окантовка зоны сброса файлов для назначения замен -->
                    <local:DropZoneOverlay x:Name="TargetDropOverlay" Grid.RowSpan="2" Margin="-8" />

                    <TextBlock Text="Назначение замен" 
                               FontWeight="SemiBold" 
                               FontSize="14" 
                               Margin="0,0,0,12" />

                    <!-- Пустое состояние: файлы не загружены -->
                    <StackPanel x:Name="TracksEmptyState"
                                Grid.Row="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="8">
                        <ProgressRing x:Name="TracksProgressRing" IsActive="False" Visibility="Collapsed" Width="32" Height="32" />
                        <FontIcon x:Name="TracksEmptyIcon"
                                  Glyph="&#xE8E5;" 
                                  FontSize="28" 
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                  HorizontalAlignment="Center" />
                        <TextBlock x:Name="TracksEmptyText"
                                   Text="Перетащите сюда исходные файлы или добавьте их на вкладке «Файлы»." 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />
                    </StackPanel>

                    <!-- Список дорожек оригинального контейнера с ComboBox для выбора замен -->
                    <ScrollViewer Grid.Row="1" 
                                  x:Name="TracksScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="Collapsed">
                        <StackPanel x:Name="ReplacementsStackPanel" Spacing="12" Padding="0,0,12,0" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Правая колонка: Файлы для подмены (с поддержкой Drag and Drop) -->
            <Border Grid.Column="1"
                    x:Name="ReplacementFilesCardBorder"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="16"
                    AllowDrop="True"
                    DragOver="ReplacementCard_DragOver"
                    DragLeave="ReplacementCard_DragLeave"
                    Drop="ReplacementCard_Drop"
                    VerticalAlignment="Stretch">
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Универсальная окантовка зоны сброса файлов -->
                    <local:DropZoneOverlay x:Name="DropOverlay" Grid.RowSpan="3" Margin="-8" />

                    <TextBlock Text="Файлы для подмены" 
                               FontWeight="SemiBold" 
                               FontSize="14" 
                               Margin="0,0,0,12" />

                    <!-- Список добавленных файлов-замен -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <!-- Пустое состояние: список пуст -->
                        <StackPanel x:Name="ReplacementsEmptyState"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                            <FontIcon Glyph="&#xE8E5;" 
                                      FontSize="28" 
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                      HorizontalAlignment="Center" />
                            <TextBlock x:Name="ReplacementsEmptyText"
                                       Text="Перетащите сюда файлы для подмены или добавьте их кнопкой ниже." 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center" />
                        </StackPanel>

                        <ListView x:Name="ReplacementFilesListView"
                                  SelectionMode="None"
                                  Visibility="Collapsed"
                                  Padding="0">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:ReplacementFileItem">
                                    <Grid Padding="4" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Имя файла -->
                                        <TextBlock Grid.Column="0" 
                                                   Text="{x:Bind FileName, Mode=OneTime}" 
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />
                                        
                                        <!-- Подпись о типе/размере -->
                                        <TextBlock Grid.Column="0" 
                                                   Grid.Row="1"
                                                   Text="{x:Bind InfoText, Mode=OneTime}" 
                                                   FontSize="10"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                        <!-- Кнопка удаления файла из списка замен -->
                                        <Button Grid.Column="1" 
                                                Grid.RowSpan="2"
                                                Click="DeleteReplacementFile_Click"
                                                DataContext="{x:Bind}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Width="28"
                                                Height="28"
                                                Padding="0"
                                                MinWidth="0"
                                                MinHeight="0"
                                                VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE711;" FontSize="12" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- Нижняя панель действий для файлов-замен -->
                    <StackPanel Grid.Row="2" Spacing="8">
                        <Button x:Name="AddReplacementButton"
                                Click="AddReplacementButton_Click"
                                HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="OpenFile" />
                                <TextBlock Text="Добавить файлы..." />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ClearReplacementsButton"
                                Click="ClearReplacementsButton_Click"
                                HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Clear" />
                                <TextBlock Text="Очистить список" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
