<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="KTools_App.UI.Controls.ScriptSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:community="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <NavigationView x:Name="SettingsNavigationView" 
                        Grid.Row="0"
                        PaneDisplayMode="Top"
                        SelectionFollowsFocus="Enabled" 
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        AlwaysShowHeader="False"
                        SelectionChanged="SettingsNavigationView_SelectionChanged"
                        Margin="0,-2,0,4"
                        Padding="0">
            <NavigationView.Resources>
                <!-- Делаем фон области контента прозрачным -->
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <!-- Убираем рамку вокруг области контента -->
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                <!-- Сбрасываем внутренние боковые отступы области контента NavigationView -->
                <Thickness x:Key="NavigationViewContentMargin">0,0,0,0</Thickness>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <!-- Будет заполняться динамически -->
            </NavigationView.MenuItems>
        </NavigationView>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0">
            <ContentControl x:Name="SettingsContentControl" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <StackPanel x:Name="SettingsContainer" 
                            Spacing="12" 
                            Padding="0,4,0,24" 
                            HorizontalAlignment="Stretch">
                    <!-- Динамические группы настроек будут вставляться сюда программно -->
                </StackPanel>
            </ContentControl>
        </ScrollViewer>
    </Grid>
</UserControl>

