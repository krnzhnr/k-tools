<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="KTools_App.UI.Controls.AudioTransplantControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,12,12">
        <StackPanel Spacing="16">

            <!-- 1. Исходное видео/аудио -->
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="16"
                    AllowDrop="True"
                    Drop="SourceCard_Drop"
                    DragOver="Card_DragOver">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE189;" FontFamily="Segoe Fluent Icons" Foreground="#00E5FF" />
                        <TextBlock Text="1. Исходное видео/аудио" FontWeight="SemiBold" FontSize="14" Foreground="#00E5FF" />
                    </StackPanel>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SourcePathTextBox" 
                                 PlaceholderText="Перетащите файл сюда или нажмите «Обзор...»" 
                                 TextChanged="SourcePathTextBox_TextChanged" 
                                 Height="36" />
                        <Button Grid.Column="1" Content="Обзор..." Click="BrowseSource_Click" Height="36" />
                    </Grid>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Аудиодорожка для переноса:" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ComboBox x:Name="SourceTrackComboBox" 
                                  HorizontalAlignment="Stretch" 
                                  PlaceholderText="Сначала выберите файл источника..." 
                                  SelectionChanged="SourceTrackComboBox_SelectionChanged" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 2. Целевое видео -->
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="16"
                    AllowDrop="True"
                    Drop="DestCard_Drop"
                    DragOver="Card_DragOver">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE116;" FontFamily="Segoe Fluent Icons" Foreground="#81C784" />
                        <TextBlock Text="2. Целевое видео" FontWeight="SemiBold" FontSize="14" Foreground="#81C784" />
                    </StackPanel>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DestPathTextBox" 
                                 PlaceholderText="Перетащите целевое видео сюда или нажмите «Обзор...»" 
                                 TextChanged="DestPathTextBox_TextChanged" 
                                 Height="36" />
                        <Button Grid.Column="1" Content="Обзор..." Click="BrowseDest_Click" Height="36" />
                    </Grid>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Дорожка целевого видео (для выравнивания осциллограммы):" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ComboBox x:Name="DestTrackComboBox" 
                                  HorizontalAlignment="Stretch" 
                                  PlaceholderText="Сначала выберите целевое видео..." 
                                  SelectionChanged="DestTrackComboBox_SelectionChanged" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 3. Файл субтитров (необязательно) -->
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="16"
                    AllowDrop="True"
                    Drop="SubtitlesCard_Drop"
                    DragOver="Card_DragOver">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8D2;" FontFamily="Segoe Fluent Icons" Foreground="#A878E8" />
                        <TextBlock Text="3. Файл субтитров (необязательно)" FontWeight="SemiBold" FontSize="14" Foreground="#A878E8" />
                    </StackPanel>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SubtitlesPathTextBox" 
                                 PlaceholderText="Перетащите файл субтитров (.ass, .srt, .vtt) или нажмите «Обзор...»" 
                                 TextChanged="SubtitlesPathTextBox_TextChanged" 
                                 Height="36" />
                        <Button Grid.Column="1" Content="Обзор..." Click="BrowseSubtitles_Click" Height="36" />
                        <Button Grid.Column="2" Content="Очистить" Click="ClearSubtitles_Click" Height="36" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 4. Визуальная синхронизация -->
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B9;" FontFamily="Segoe Fluent Icons" Foreground="#FF4081" />
                        <TextBlock Text="4. Визуальная синхронизация осциллограмм" FontWeight="SemiBold" FontSize="14" Foreground="#FF4081" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <Button x:Name="OpenSyncWindowButton" 
                                Click="OpenSyncWindowButton_Click" 
                                Style="{StaticResource AccentButtonStyle}" 
                                Height="36">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE9E9;" FontFamily="Segoe Fluent Icons" />
                                        <TextBlock Text="Визуальная синхронизация..." />
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>

                        <TextBlock x:Name="ShiftStatusTextBlock" 
                                   Text="Выбранный сдвиг: 0 мс" 
                                   VerticalAlignment="Center" 
                                   FontSize="13" 
                                   FontWeight="SemiBold" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
