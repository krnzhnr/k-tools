<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="KTools_App.UI.Controls.FileListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:KTools_App.UI.Controls"
    xmlns:core="using:KTools_App.Core"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">

    <Grid x:Name="RootGrid" 
          AllowDrop="True" 
          DragOver="RootGrid_DragOver" 
          Drop="RootGrid_Drop"
          Background="Transparent">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Предупреждение о правах администратора (влияет на Drag & Drop) -->
        <InfoBar Grid.Row="0"
                 x:Name="AdminWarningBar"
                 Severity="Warning"
                 Title="Запуск от имени администратора"
                 Message="Перетаскивание файлов (Drag-and-Drop) заблокировано безопасностью Windows из-за повышенных привилегий приложения. Пожалуйста, используйте кнопку «Добавить файлы» ниже."
                 IsOpen="False"
                 IsClosable="True"
                 Margin="0,0,0,12" />
        
        <!-- Пустая панель: когда файлы не выбраны -->
        <Border Grid.Row="1" 
                x:Name="EmptyPanel"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8"
                Margin="0,0,0,12"
                Padding="24"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                <SymbolIcon Symbol="OpenFile" 
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                             Width="48" 
                             Height="48" />
                <TextBlock x:Name="DragDropPromptTextBlock"
                            Text="Перетащите файлы сюда или используйте кнопку ниже" 
                            FontSize="14" 
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center" />
                <TextBlock x:Name="DragDropSubPromptTextBlock"
                            Text="Поддерживаются файлы медиаформатов для выбранного скрипта" 
                            FontSize="11" 
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Список файлов (Обычный) -->
        <ListView Grid.Row="1"
                  x:Name="FilesListView"
                  Visibility="Collapsed"
                  SelectionMode="Extended"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  CornerRadius="8"
                  Margin="0,0,0,12"
                  Padding="4">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="core:FileQueueItem">
                    <Grid HorizontalAlignment="Stretch" Padding="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Название файла -->
                        <TextBlock Grid.Column="0"
                                   Text="{x:Bind FileName}"
                                   x:Phase="1"
                                   Style="{ThemeResource BaseTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="6,6,12,0"/>
                        
                        <!-- Размер файла -->
                        <TextBlock Grid.Column="0"
                                   Grid.Row="1"
                                   Text="{x:Bind FileSizeStr}"
                                   x:Phase="2"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   Margin="6,0,12,6"/>

                        <!-- Кольцевой прогресс-бар и иконка статуса -->
                        <Grid Grid.Column="1"
                               Grid.RowSpan="2" 
                               Width="32" 
                               Height="32" 
                               Margin="6,6,4,6" 
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Center">
                            
                            <ProgressRing Value="{x:Bind Progress, Mode=OneWay}"
                                           Maximum="100"
                                           IsIndeterminate="{x:Bind IsProgressIndeterminate, Mode=OneWay}"
                                           IsActive="True"
                                           Width="24"
                                           Height="24"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                           Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                                           Visibility="{x:Bind ProgressRingVisibility, Mode=OneWay}" />

                            <SymbolIcon Symbol="{x:Bind StatusIcon, Mode=OneWay}"
                                         Foreground="{x:Bind StatusIconBrush, Mode=OneWay}"
                                         Visibility="{x:Bind StatusIconVisibility, Mode=OneWay}"
                                         Width="24"
                                         Height="24"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
                        </Grid>

                        <!-- Кнопка вызова нативного GPU-графика битрейта Win2D -->
                        <Button Grid.Column="2"
                                Grid.RowSpan="2"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Width="32"
                                Height="32"
                                MinWidth="0"
                                MinHeight="0"
                                Margin="2,0,4,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Click="OpenBitrateGraphButton_Click"
                                ToolTipService.ToolTip="Открыть GPU-график битрейта (Win2D)"
                                Visibility="{x:Bind HasBitrateData, Mode=OneWay}">
                            <FontIcon FontSize="16" Glyph="&#xE9D2;"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                        </Button>

                        <!-- Кнопка удаления файла из очереди -->
                        <Button Grid.Column="3" 
                                Grid.RowSpan="2"
                                x:Name="DeleteButton"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Width="32"
                                Height="32"
                                MinWidth="0"
                                MinHeight="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Click="DeleteButton_Click"
                                ToolTipService.ToolTip="Удалить из списка"
                                IsEnabled="{x:Bind IsDeleteEnabled, Mode=OneWay}">
                            <FontIcon FontSize="20" Glyph="&#xE711;"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Таблица для сборки MKV (Муксинг) -->
        <Grid Grid.Row="1" 
              x:Name="MuxingGrid" 
              Visibility="Collapsed"
              Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Заголовки колонок -->
                <RowDefinition Height="*" />    <!-- Список строк -->
            </Grid.RowDefinitions>

            <!-- Заголовки колонок таблицы -->
            <Border Grid.Row="0"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,1,1,0"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="8,8,0,0"
                    Padding="12,8,12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="72" /> <!-- Столбец статуса и удаления -->
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="Видео" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="Аудио" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="12,0,0,0" />
                    <TextBlock Grid.Column="2" Text="Субтитры" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="12,0,0,0" />
                    <TextBlock Grid.Column="3" Text="Статус" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="8,0,0,0" HorizontalAlignment="Left" />
                </Grid>
            </Border>

            <!-- Список строк муксинга -->
            <ListView Grid.Row="1"
                      x:Name="MuxingListView"
                      SelectionMode="None"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      CornerRadius="0,0,8,8"
                      Padding="0">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="4,2,4,2" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:MuxingRowItem">
                        <Grid Padding="8,4,8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="72" />
                            </Grid.ColumnDefinitions>

                            <!-- Видеофайл -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind VideoFile.FileName, Mode=OneWay, FallbackValue='—'}" 
                                           TextTrimming="CharacterEllipsis"
                                           Style="{ThemeResource BaseTextBlockStyle}" />
                            </StackPanel>

                            <!-- Аудиофайл -->
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind AudioDisplayText, Mode=OneWay, FallbackValue='—'}" 
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{ThemeResource BodyTextBlockStyle}" />
                            </StackPanel>

                            <!-- Файл субтитров -->
                            <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind SubsDisplayText, Mode=OneWay, FallbackValue='—'}" 
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{ThemeResource BodyTextBlockStyle}" />
                            </StackPanel>

                            <!-- Статус сборки и кнопка удаления всей строки -->
                            <Grid Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Иконка статуса / Кольцевой прогресс-бар -->
                                <Grid Grid.Column="0" 
                                      Width="24" 
                                      Height="24" 
                                      HorizontalAlignment="Left" 
                                      VerticalAlignment="Center">
                                    
                                    <ProgressRing Value="{x:Bind VideoFile.Progress, Mode=OneWay, FallbackValue=0}"
                                                  Maximum="100"
                                                  IsIndeterminate="{x:Bind VideoFile.IsProgressIndeterminate, Mode=OneWay, FallbackValue=False}"
                                                  IsActive="True"
                                                  Width="20"
                                                  Height="20"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                  Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                                                  Visibility="{x:Bind VideoFile.ProgressRingVisibility, Mode=OneWay, FallbackValue=Collapsed}" />

                                    <SymbolIcon Symbol="{x:Bind VideoFile.StatusIcon, Mode=OneWay, FallbackValue=Clock}"
                                                Foreground="{x:Bind VideoFile.StatusIconBrush, Mode=OneWay}"
                                                Visibility="{x:Bind VideoFile.StatusIconVisibility, Mode=OneWay, FallbackValue=Visible}"
                                                Width="20"
                                                Height="20"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                </Grid>

                                <!-- Кнопка удаления -->
                                <Button Grid.Column="1" 
                                        Click="DeleteMuxingRow_Click"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Width="32"
                                        Height="32"
                                        MinWidth="0"
                                        MinHeight="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        ToolTipService.ToolTip="Удалить из списка"
                                        IsEnabled="{x:Bind IsDeleteEnabled, Mode=OneWay}">
                                    <FontIcon FontSize="20" Glyph="&#xE711;"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                </Button>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Список для загрузчика (Сеть) -->
        <ListView Grid.Row="1"
                  x:Name="DownloaderListView"
                  Visibility="Collapsed"
                  SelectionMode="None"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  CornerRadius="8"
                  Margin="0,0,0,12"
                  Padding="4">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="4,2,4,2" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="core:FileQueueItem">
                    <Grid HorizontalAlignment="Stretch" Padding="8,4,8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Блок выбора качеств и субтитров сверху слева -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="12" Margin="6,0,12,8">
                            <!-- Выбор качества/формата -->
                            <ComboBox ItemsSource="{x:Bind AvailableFormats, Mode=OneWay}"
                                      SelectedItem="{x:Bind SelectedFormat, Mode=TwoWay}"
                                      Header="Формат и качество"
                                      Width="250"
                                      VerticalAlignment="Center"
                                      IsEnabled="{x:Bind IsDeleteEnabled, Mode=OneWay}" />
 
                            <!-- Выбор субтитров -->
                            <ComboBox ItemsSource="{x:Bind AvailableSubtitles, Mode=OneWay}"
                                      SelectedItem="{x:Bind SelectedSubtitle, Mode=TwoWay}"
                                      Header="Субтитры"
                                      Width="165"
                                      VerticalAlignment="Center"
                                      IsEnabled="{x:Bind IsDeleteEnabled, Mode=OneWay}"
                                      Visibility="{x:Bind ShowSubtitlesSelector, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>

                        <!-- Название видео/аудио под комбобоксами -->
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="{x:Bind DisplayName, Mode=OneWay}"
                                   Style="{ThemeResource BaseTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Margin="6,0,12,4"/>

                        <!-- Кольцевой прогресс-бар и иконка статуса -->
                        <Grid Grid.Column="1" Grid.RowSpan="2"
                              Width="32" 
                              Height="32" 
                              Margin="6,0,12,0" 
                              VerticalAlignment="Center" 
                              HorizontalAlignment="Center">
                             
                             <ProgressRing Value="{x:Bind Progress, Mode=OneWay}"
                                           Maximum="100"
                                           IsIndeterminate="{x:Bind IsProgressIndeterminate, Mode=OneWay}"
                                           IsActive="True"
                                           Width="24"
                                           Height="24"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                           Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                                           Visibility="{x:Bind ProgressRingVisibility, Mode=OneWay}" />
 
                             <SymbolIcon Symbol="{x:Bind StatusIcon, Mode=OneWay}"
                                         Foreground="{x:Bind StatusIconBrush, Mode=OneWay}"
                                         Visibility="{x:Bind StatusIconVisibility, Mode=OneWay}"
                                         Width="24"
                                         Height="24"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
                        </Grid>
 
                        <!-- Кнопка удаления из списка -->
                        <Button Grid.Column="2" Grid.RowSpan="2"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Width="32"
                                Height="32"
                                MinWidth="0"
                                MinHeight="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Click="DeleteButton_Click"
                                ToolTipService.ToolTip="Удалить из списка"
                                IsEnabled="{x:Bind IsDeleteEnabled, Mode=OneWay}">
                            <FontIcon FontSize="20" Glyph="&#xE711;"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
 
        <!-- Тулбар списка файлов снизу -->
        <CommandBar Grid.Row="2" 
                    DefaultLabelPosition="Right"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Left">
            <AppBarButton x:Name="AddFilesButton"
                          Icon="OpenFile" 
                          Label="Добавить файлы" 
                          Click="AddFilesButton_Click" />
            <AppBarButton x:Name="ClearListButton"
                          Icon="Clear" 
                          Label="Очистить список" 
                          Click="ClearListButton_Click" />
        </CommandBar>
    </Grid>
</UserControl>
