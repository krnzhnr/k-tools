<UserControl
    x:Class="KTools_App.UI.Controls.TrackSelectionControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:KTools_App.UI.Controls"
    mc:Ignorable="d">

    <Grid Padding="0,16,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Заголовок (0) -->
            <RowDefinition Height="Auto" /> <!-- Вкладки категорий (1) -->
            <RowDefinition Height="Auto" /> <!-- Панель Flyout-фильтров (2) -->
            <RowDefinition Height="*" />    <!-- Дерево дорожек (3) -->
        </Grid.RowDefinitions>

        <!-- Заголовок панели выбора дорожек -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16" Spacing="4">
            <TextBlock x:Name="TitleTextBlock"
                       Text="Выбор дорожек и встроенных шрифтов" 
                       FontSize="16" 
                       FontWeight="SemiBold" 
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock x:Name="DescriptionTextBlock"
                       Text="Отметьте галочками аудио, видео, субтитры или шрифты, которые вы хотите извлечь из контейнеров." 
                       FontSize="12" 
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Вкладки категорий фильтров -->
        <NavigationView x:Name="FilterNavigationView"
                        Grid.Row="1"
                        PaneDisplayMode="Top"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        AlwaysShowHeader="False"
                        SelectionChanged="FilterNavigationView_SelectionChanged"
                        Margin="0,0,0,8"
                        Height="Auto">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Видео" Tag="video" x:Name="VideoFilterTab" Icon="Video">
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="VideoInfoBadge" Style="{StaticResource InformationalValueInfoBadgeStyle}" Visibility="Collapsed" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem Content="Аудио" Tag="audio" x:Name="AudioFilterTab" Icon="Audio">
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="AudioInfoBadge" Style="{StaticResource InformationalValueInfoBadgeStyle}" Visibility="Collapsed" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem Content="Субтитры" Tag="subtitles" x:Name="SubtitleFilterTab" Icon="Message">
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="SubtitleInfoBadge" Style="{StaticResource InformationalValueInfoBadgeStyle}" Visibility="Collapsed" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem Content="Вложения" Tag="attachments" x:Name="AttachmentFilterTab" Icon="Attach">
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="AttachmentInfoBadge" Style="{StaticResource InformationalValueInfoBadgeStyle}" Visibility="Collapsed" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
            </NavigationView.MenuItems>
        </NavigationView>

        <!-- Компактная панель кнопок с выпадающими меню (Flyouts) -->
        <Border x:Name="FiltersBorder"
                Grid.Row="2"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8"
                Padding="12,8"
                Margin="0,0,0,12"
                Visibility="Collapsed">
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Чекбокс Выбрать все -->
                <CheckBox x:Name="SelectAllCheckBox"
                          Grid.Column="0"
                          Content="Выбрать все"
                          Click="SelectAllCheckBox_Click"
                          VerticalAlignment="Center"
                          Margin="0,0,16,0" />

                <!-- Горизонтальный скроллер для кнопок-фильтров -->
                <ScrollViewer x:Name="FilterScrollViewer"
                              Grid.Column="1"
                              HorizontalScrollMode="Enabled"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Disabled"
                              SizeChanged="FilterScrollViewer_SizeChanged">
                    <StackPanel x:Name="FilterButtonsStackPanel"
                                Orientation="Horizontal"
                                Spacing="8"
                                Padding="0,2"
                                SizeChanged="FilterButtonsStackPanel_SizeChanged">
                        <!-- Кнопки-фильтры -->
                        <Button x:Name="LanguageFilterButton" Visibility="Collapsed" Height="32">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE774;" FontSize="14" />
                                    <TextBlock x:Name="LanguageFilterText" Text="Язык ▼" VerticalAlignment="Center" />
                                    <InfoBadge x:Name="LanguageInfoBadge" Style="{StaticResource InformationalValueInfoBadgeStyle}" Margin="4,0,0,0" Visibility="Collapsed" />
                                </StackPanel>
                            </Button.Content>
                            <Button.Flyout>
                                <Flyout>
                                    <ScrollViewer MaxHeight="300" MinWidth="160" VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="LanguageFilterContainer" Spacing="6" Padding="4" />
                                    </ScrollViewer>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Button x:Name="CodecFilterButton" Visibility="Collapsed" Height="32">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE943;" FontSize="14" />
                                    <TextBlock x:Name="CodecFilterText" Text="Кодек ▼" VerticalAlignment="Center" />
                                    <InfoBadge x:Name="CodecInfoBadge" Style="{StaticResource InformationalValueInfoBadgeStyle}" Margin="4,0,0,0" Visibility="Collapsed" />
                                </StackPanel>
                            </Button.Content>
                            <Button.Flyout>
                                <Flyout>
                                    <ScrollViewer MaxHeight="300" MinWidth="160" VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="CodecFilterContainer" Spacing="6" Padding="4" />
                                    </ScrollViewer>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Button x:Name="DetailFilterButton" Visibility="Collapsed" Height="32">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE7F4;" FontSize="14" />
                                    <TextBlock x:Name="DetailFilterText" Text="Разрешение ▼" VerticalAlignment="Center" />
                                    <InfoBadge x:Name="DetailInfoBadge" Style="{StaticResource InformationalValueInfoBadgeStyle}" Margin="4,0,0,0" Visibility="Collapsed" />
                                </StackPanel>
                            </Button.Content>
                            <Button.Flyout>
                                <Flyout>
                                    <ScrollViewer MaxHeight="300" MinWidth="160" VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="DetailFilterContainer" Spacing="6" Padding="4" />
                                    </ScrollViewer>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Button x:Name="NameFilterButton" Visibility="Collapsed" Height="32">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8C7;" FontSize="14" />
                                    <TextBlock x:Name="NameFilterText" Text="Название ▼" VerticalAlignment="Center" />
                                    <InfoBadge x:Name="NameInfoBadge" Style="{StaticResource InformationalValueInfoBadgeStyle}" Margin="4,0,0,0" Visibility="Collapsed" />
                                </StackPanel>
                            </Button.Content>
                            <Button.Flyout>
                                <Flyout>
                                    <ScrollViewer MaxHeight="300" MinWidth="220" VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="NameFilterContainer" Spacing="6" Padding="4" />
                                    </ScrollViewer>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Дерево дорожек с поддержкой множественного выбора -->
        <Border Grid.Row="3" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8"
                Padding="12"
                VerticalAlignment="Stretch">
            
            <Grid>
                <!-- Состояние, когда файлы еще не загружены/анализируются -->
                <StackPanel x:Name="EmptyStatePanel" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center" 
                            Spacing="12"
                            Visibility="Visible">
                    <ProgressRing IsActive="True" Width="36" Height="36" />
                    <TextBlock Text="Загрузка и асинхронный анализ структуры медиафайлов..." 
                               FontSize="13" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Основной виджет дерева с поддержкой множественного чекбокс-выбора -->
                <TreeView x:Name="TracksTreeView" 
                          SelectionMode="Multiple"
                          Visibility="Collapsed"
                          SelectionChanged="TracksTreeView_SelectionChanged"
                          VerticalAlignment="Stretch">
                    <TreeView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" 
                                        Spacing="10" 
                                        Padding="0,4"
                                        Margin="{Binding Content.NodeMargin}">
                                <FontIcon Glyph="{Binding Content.IconGlyph}" 
                                          FontSize="16" 
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" 
                                          VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Content.Text}" 
                                           FontWeight="{Binding Content.Weight}"
                                           VerticalAlignment="Center" 
                                           FontSize="13" 
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>
        </Border>

        <!-- Подсказка о горизонтальной прокрутке -->
        <TeachingTip x:Name="FilterScrollTeachingTip"
                     Title="Горизонтальная прокрутка"
                     Subtitle="Панель содержит скрытые фильтры. Вы можете прокручивать их горизонтально с помощью колесика мыши при наведении курсора или жестом на тачпаде."
                     PreferredPlacement="Bottom"
                     Target="{x:Bind FilterScrollViewer}">
            <TeachingTip.IconSource>
                <SymbolIconSource Symbol="TouchPointer" />
            </TeachingTip.IconSource>
        </TeachingTip>
    </Grid>
</UserControl>
