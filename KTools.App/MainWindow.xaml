<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="KTools_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:KTools_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="K-Tools"
    mc:Ignorable="d">


    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Сплошная подложка режима «Обычный» без эффектов.
             Кисть SolidBackdropBackgroundBrush из ThemeDictionaries сама следит за темой,
             код только показывает или скрывает слой. Первый дочерний — рисуется позади всего. -->
        <Grid x:Name="SolidBackdropOverlay"
              Grid.Row="0" Grid.RowSpan="2"
              Background="{ThemeResource SolidBackdropBackgroundBrush}"
              Visibility="Collapsed" />

        <TitleBar x:Name="AppTitleBar" Title="K-Tools" Grid.Row="0">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!--
            The Frame hosts pages for your application content. Add your UI to
            MainPage.xaml rather than here so you can use Page features such as
            navigation events and the Loaded lifecycle.
        -->
        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
