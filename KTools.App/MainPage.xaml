<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="KTools_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:KTools_App"
    xmlns:viewmodels="using:KTools_App.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:DataType="viewmodels:MainViewModel"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" IsTabStop="True">
        <!-- Главное меню навигации приложения -->
        <NavigationView x:Name="NavView"
                         PaneDisplayMode="Left"
                         IsPaneOpen="False"
                         IsBackButtonVisible="Collapsed"
                         IsPaneToggleButtonVisible="False"
                         AlwaysShowHeader="False"
                         Loaded="NavView_Loaded"
                         SelectionChanged="NavView_SelectionChanged"
                         PaneOpened="NavView_PaneOpened"
                         PaneClosed="NavView_PaneClosed"
                         PaneOpening="NavView_PaneOpening"
                         PaneClosing="NavView_PaneClosing">
            
            <NavigationView.Resources>
                <!-- Отключаем наложение Acrylic на панель, делая ее фон прозрачным. 
                     Это предотвращает черные вспышки DWM из-за конфликта HostBackdrop и AcrylicBackdrop окна. -->
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <!-- Главная страница -->
                <NavigationViewItem Content="Главная" Icon="Home" x:Name="NavItemHome" Tag="home" />
                <NavigationViewItemSeparator x:Name="HomeSeparator" />
                <NavigationViewItemHeader Content="Скрипты обработки" />

                <!-- Группа: Видео -->
                <NavigationViewItem Content="Видео" Icon="Video" x:Name="NavItemVideo" SelectsOnInvoked="False">
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem Content="Кодирование видео" Tag="script:video_encoding">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE116;" FontFamily="Segoe Fluent Icons" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="Конвертация контейнера" Tag="script:container_conversion">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE895;" FontFamily="Segoe Fluent Icons" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="Очистка метаданных" Tag="script:metadata_cleanup">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xEA99;" FontFamily="Segoe Fluent Icons" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>

                <!-- Группа: Аудио -->
                <NavigationViewItem Content="Аудио" Icon="Audio" x:Name="NavItemAudio" SelectsOnInvoked="False">
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem Content="Кодирование аудио" Tag="script:audio_encoding">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE189;" FontFamily="Segoe Fluent Icons" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="Даунмикс в Stereo" Tag="script:audio_downmix">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xEA3C;" FontFamily="Segoe Fluent Icons" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="Изменение скорости" Tag="script:audio_speed">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xEC49;" FontFamily="Segoe Fluent Icons" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="Разделение каналов" Tag="script:audio_channels">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE8C6;" FontFamily="Segoe Fluent Icons" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="Сдвиг аудио" Tag="script:audio_shift">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE121;" FontFamily="Segoe Fluent Icons" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>

                <!-- Группа: Контейнеры -->
                <NavigationViewItem Content="Контейнеры" Icon="Share" x:Name="NavItemContainers" SelectsOnInvoked="False">
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem Content="Сборка MKV" Tag="script:mkv_assembly">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE7B8;" FontFamily="Segoe Fluent Icons" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="Управление потоками" Tag="script:stream_management">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE762;" FontFamily="Segoe Fluent Icons" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="Замена потоков" Tag="script:stream_replacement">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE8AB;" FontFamily="Segoe Fluent Icons" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="Разборка контейнера" Tag="script:container_demux">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE7AC;" FontFamily="Segoe Fluent Icons" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>

                <!-- Группа: Субтитры -->
                <NavigationViewItem Content="Субтитры" Icon="Font" x:Name="NavItemSubtitles" SelectsOnInvoked="False">
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem Content="ASS/SRT → VTT" Tag="script:subtitles_convert">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE8D2;" FontFamily="Segoe Fluent Icons" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="Сдвиг субтитров" Tag="script:subtitles_shift">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE121;" FontFamily="Segoe Fluent Icons" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>

                <!-- Группа: Сеть -->
                <NavigationViewItem Content="Сеть" Icon="World" x:Name="NavItemNetwork" SelectsOnInvoked="False">
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem Content="Загрузка медиа" Tag="script:media_downloader">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE128;" FontFamily="Segoe Fluent Icons" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>

                <!-- Группа: Инструменты -->
                <NavigationViewItem Content="Инструменты" Icon="Repair" x:Name="NavItemTools" SelectsOnInvoked="False">
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem Content="Калькулятор сдвига" Tag="tool:timing_calculator">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE1D0;" FontFamily="Segoe Fluent Icons" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Фиксированные пункты меню внизу -->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Логи" x:Name="NavItemLogs" Tag="logs"
                                    Visibility="{x:Bind ViewModel.IsLogsTabVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE756;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Компоненты" x:Name="NavItemDependencies" Tag="dependencies">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- Основной контент страницы -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Статичная шапка программы, прижатая к левому краю -->
                <StackPanel Grid.Row="0" Spacing="4" Margin="36,24,24,8" HorizontalAlignment="Left">
                    <TextBlock x:Name="HeaderTitle"
                               Text="{x:Bind ViewModel.HeaderTitle, Mode=OneWay}" 
                               FontFamily="Segoe UI" 
                               FontSize="28" 
                               FontWeight="Bold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" 
                               HorizontalAlignment="Left" />
                    <TextBlock x:Name="HeaderSubtitle"
                               Text="{x:Bind ViewModel.HeaderSubtitle, Mode=OneWay}" 
                               FontFamily="Segoe UI" 
                               FontSize="14" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                               HorizontalAlignment="Left" />
                </StackPanel>

                <!-- Область отображения дочерних страниц (пилюля обновления живёт в TitleBar) -->
                <Grid Grid.Row="1">
                    <!--
                        В WinUI 3 Frame не имеет перехода по умолчанию, поэтому анимация
                        навигации задается явно: плавное появление содержимого при переходах
                        между главной страницей, логами, настройками и рабочей панелью.
                    -->
                    <Frame x:Name="ContentFrame" Margin="0">
                        <Frame.ContentTransitions>
                            <TransitionCollection>
                                <NavigationThemeTransition />
                            </TransitionCollection>
                        </Frame.ContentTransitions>
                    </Frame>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Page>
