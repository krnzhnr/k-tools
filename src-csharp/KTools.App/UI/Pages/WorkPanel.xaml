<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="KTools_App.UI.Pages.WorkPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:KTools_App.ViewModels"
    x:DataType="viewmodels:WorkPanelViewModel"
    mc:Ignorable="d">

    <Grid Padding="36,12,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Баннер недостающих зависимостей -->
            <RowDefinition Height="*" />    <!-- Основная рабочая область -->
            <RowDefinition Height="Auto" /> <!-- Нижняя панель управления -->
        </Grid.RowDefinitions>

        <InfoBar x:Name="DependencyWarningBar" 
                 Grid.Row="0"
                 Severity="Warning"
                 Title="Недостающие компоненты"
                 Message="{x:Bind ViewModel.DependencyWarningText, Mode=OneWay}"
                 IsOpen="{x:Bind ViewModel.IsDependencyWarningOpen, Mode=OneWay}"
                 IsClosable="False"
                 Margin="0,0,0,12">
            <InfoBar.ActionButton>
                <Button Content="Установить" Click="InstallDependencies_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- Двухвкладочный NavigationView-контейнер (как в примере) -->
        <NavigationView x:Name="nvSample" 
                          Grid.Row="1" 
                          PaneDisplayMode="Top"
                          IsSettingsVisible="False"
                          IsBackButtonVisible="Collapsed"
                          AlwaysShowHeader="False"
                          SelectionChanged="nvSample_SelectionChanged"
                          SelectionFollowsFocus="Enabled"
                          Margin="0,0,0,16">
            <NavigationView.Resources>
                <!-- Делаем фон области контента прозрачным -->
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <!-- Убираем рамку вокруг области контента -->
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                <!-- Сбрасываем внутренние боковые отступы области контента NavigationView -->
                <Thickness x:Key="NavigationViewContentMargin">0,0,0,0</Thickness>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem Icon="Document" Content="Файлы" x:Name="SamplePage1Item" Tag="files" />
                <NavigationViewItem Icon="Setting" Content="Настройки" x:Name="SamplePage2Item" Tag="settings" />
            </NavigationView.MenuItems>
            
            <!-- Фрейм контента вкладок -->
            <Frame x:Name="contentFrame" Margin="0" />
        </NavigationView>

        <!-- Фиксированная нижняя панель запуска и прогресса -->
        <Border Grid.Row="2" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8"
                Padding="24,12,24,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- 1 строка: Статус и Прогресс-бар -->
                    <RowDefinition Height="Auto" /> <!-- 2 строка: Путь, Обзор, Выполнить -->
                </Grid.RowDefinitions>

                <!-- Строка 1: Прогресс-бар и Статус (как в оригинале) -->
                <StackPanel Grid.Row="0" Margin="0,0,0,12" Spacing="4">
                    <TextBlock x:Name="StatusTextBlock" 
                               Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" 
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ProgressBar x:Name="GlobalProgressBar" 
                                 Maximum="100" 
                                 Value="{x:Bind ViewModel.GlobalProgressValue, Mode=OneWay}" 
                                 Height="4" 
                                 HorizontalAlignment="Stretch" />
                </StackPanel>

                <!-- Строка 2: Выбор пути, Обзор и Выполнить (как в оригинале) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Текстовое поле ввода пути -->
                    <TextBox x:Name="OutputPathTextBox" 
                             Grid.Column="0"
                             Text="{x:Bind ViewModel.OutputPath, Mode=TwoWay}"
                             IsEnabled="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                             PlaceholderText="По умолчанию (в папку с исходными файлами)" 
                             VerticalAlignment="Center"
                             Height="36"
                             Margin="0,0,8,0" />

                    <!-- Кнопка Обзора -->
                    <Button Grid.Column="1"
                            Content="Обзор..." 
                            Click="BrowseFolder_Click" 
                            IsEnabled="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                            VerticalAlignment="Center"
                            Height="36"
                            Width="100"
                            Margin="0,0,12,0" />

                    <!-- Кнопки Запуска и Отмены -->
                    <StackPanel Grid.Column="2" 
                                Orientation="Horizontal" 
                                Spacing="8" 
                                VerticalAlignment="Center">
                        <Button x:Name="CancelButton" 
                                Content="Отменить" 
                                Command="{x:Bind ViewModel.CancelExecutionCommand}"
                                Style="{StaticResource DefaultButtonStyle}"
                                Height="36"
                                Visibility="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        
                        <Button x:Name="StartButton" 
                                Content="Выполнить" 
                                Click="StartButton_Click"
                                IsEnabled="{x:Bind ViewModel.IsStartButtonEnabled, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}"
                                Width="140"
                                Height="36" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
